{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vp build",
    "dev": "vp dev --port 3000",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env .output/server/index.mjs",
    "test": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daniel/auth": "workspace:*",
    "@daniel/db": "workspace:*",
    "@daniel/shared": "workspace:*",
    "@daniel/utils": "workspace:*",
    "@date-fns/tz": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-table": "catalog:",
    "date-fns": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@daniel/tsconfig": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-orm": "catalog:",
