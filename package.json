{
  "name": "@daniel/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules tooling/*/node_modules apps/*/dist packages/*/dist .tanstack apps/*/.tanstack apps/*/.output .vitest-* apps/*/.vitest-* packages/*/.vitest-*",
    "dev": "pnpm --filter web dev",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings --report-unused-disable-directives && pnpm lint:effect",
    "lint:effect": "vp run -r lint:effect && effect-tsgo diagnostics --project tsconfig.json --strict",
    "prepare": "effect-tsgo patch --typescript --oxlint --force",
    "quality": "pnpm quality:fast && pnpm test",
    "quality:all": "pnpm quality && pnpm test:integration",
    "quality:fast": "pnpm fmt:check && pnpm typecheck && pnpm lint",
    "quality:fix": "pnpm fmt && vp lint --fix",
    "test": "vp run -r test",
    "test:all": "pnpm test && pnpm test:integration",
    "test:integration": "pnpm db:test-application && pnpm --filter web test:integration",
    "typecheck": "vp run -r typecheck",
    "tanstack": "vp dlx @tanstack/cli@latest",
    "db:local": "node --import tsx scripts/postgres.ts",
    "db:seed-admins": "pnpm --filter @daniel/auth seed:admins",
    "db:generate": "pnpm --filter @daniel/db db:generate",
    "db:migrate": "pnpm --filter @daniel/db db:migrate",
    "db:push": "pnpm --filter @daniel/db db:push",
    "db:studio": "pnpm --filter @daniel/db db:studio",
    "db:test-application": "pnpm --filter @daniel/db db:test-application"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
