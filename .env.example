# PostgreSQL connection used by the app, Better Auth, and Drizzle Kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daniel

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Header with the client IP when the app runs behind a proxy or load balancer, so sign-in rate
# limits apply per client. For example: x-forwarded-for
# AUTH_IP_ADDRESS_HEADER=

# Admin accounts that `pnpm db:seed-admins` creates (comma-separated), and their first password
# (at least 12 characters). Existing accounts are skipped.
ADMIN_EMAILS=
ADMIN_INITIAL_PASSWORD=

# Folder for uploaded gallery photos. Relative paths start at the repository root.
# PHOTO_STORAGE_DIR=.data/photos

# Live flight prices for the travel estimator: the API key of a SerpApi account (Google Flights).
# The free plan has 250 searches a month. Without the key, the travel page shows links only.
# Create the account in Daniel's name.
# SERPAPI_API_KEY=

# Daniel's Instagram posts on the News page: the Instagram app ID and app secret of the Meta app
# (the Instagram product's own ID and secret, not the Facebook ones). Setup: docs/instagram.md.
# Without them, the admin cannot connect the account and the News page links to Instagram.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Folder with the PostgreSQL programs (initdb, pg_ctl, postgres) when they are not on PATH.
# Used by `pnpm db:local` and the integration tests. For example: C:/pgsql/bin
# PG_BIN=

# Logging and telemetry (docs/observability.md).
# LOG_FORMAT=pretty                 # pretty | json | logfmt (json by default when NODE_ENV=production)
# LOG_LEVEL=Info                    # All | Trace | Debug | Info | Warn | Error | Fatal | None
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=api-key=secret
# OTEL_SERVICE_NAME=daniel
