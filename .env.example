# PostgreSQL connection used by the app, Better Auth, and Drizzle Kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daniel

# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Header with the client IP when the app runs behind a proxy or load balancer, so sign-in rate
# limits apply per client. For example: x-forwarded-for
# AUTH_IP_ADDRESS_HEADER=

# Admin accounts that `pnpm db:seed-admins` creates (comma-separated), and their first password
# (at least 12 characters). Existing accounts are skipped.
ADMIN_EMAILS=
ADMIN_INITIAL_PASSWORD=

# Folder for uploaded gallery photos and the photos clients send with enquiries. Relative paths
# start at the repository root.
# PHOTO_STORAGE_DIR=.data/photos

# Average flight fares for the travel estimator: the API token of a free Travelpayouts account
# (Profile, API token). The site sends it in a header. Without it, the flight card shows the
# Google Flights link only. Create the account in Daniel's name: it can also earn him commission.
# TRAVELPAYOUTS_TOKEN=

# Live hotel prices for the travel estimator, and live flight prices for routes with too few
# Travelpayouts fares: the API key of a SerpApi account (Google Hotels and Google Flights). The
# free plan has 250 searches a month. Without the key, the travel page shows the typical hotel
# prices from the admin, and rare routes show the Google Flights link only. Create the account in
# Daniel's name.
# SERPAPI_API_KEY=

# Daniel's Instagram posts on the News page: the Instagram app ID and app secret of the Meta app
# (the Instagram product's own ID and secret, not the Facebook ones). Setup: docs/instagram.md.
# Without them, the admin cannot connect the account and the News page links to Instagram.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# The Necrotic Wear shop: the store domain and the public Storefront API token of its headless
# channel (Shopify admin, Sales channels, Headless). Used by the Shop page once it exists.
# SHOPIFY_STORE_DOMAIN=necrotic-wear.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=

# Keeps a test copy of the site out of search engines (an X-Robots-Tag: noindex header). Set it to
# true on the test site only, never on the real site. See docs/deploy.md.
# HIDE_FROM_SEARCH_ENGINES=true

# Folder with the PostgreSQL programs (initdb, pg_ctl, postgres) when they are not on PATH.
# Used by `pnpm db:local` and the integration tests. For example: C:/pgsql/bin
# PG_BIN=

# Logging and telemetry (docs/observability.md).
# LOG_FORMAT=pretty                 # pretty | json | logfmt (json by default when NODE_ENV=production)
# LOG_LEVEL=Info                    # All | Trace | Debug | Info | Warn | Error | Fatal | None
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=api-key=secret
# OTEL_SERVICE_NAME=daniel
